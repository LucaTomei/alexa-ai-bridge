# Alexa AI Bridge - copy to .env, fill in, then: chmod 600 .env
# Every variable is documented in docs/setup.md#configuration-reference

# ---- Alexa ---------------------------------------------------------------
# Skill ID from the Alexa developer console (Build -> Endpoint). Requests for other skills are rejected.
SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000

# ---- Model: pick ONE block (more in docs/providers.md) ------------------
# LLM_API: "anthropic" (Messages API) or "openai" (any OpenAI-compatible Chat Completions endpoint).
# Model names are examples: use any current chat model from your provider's list. Fast models sound best.

# Anthropic Claude - native web search, nothing else to host
LLM_API=anthropic
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5

# OpenAI
# LLM_API=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.4-mini
# LLM_EXTRA_JSON={"reasoning_effort": "low"}

# Google Gemini (OpenAI-compatible endpoint)
# LLM_API=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-flash-latest
# LLM_EXTRA_JSON={"reasoning_effort": "low"}

# Mistral
# LLM_API=openai
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=...
# LLM_MODEL=mistral-small-latest

# OpenRouter (hundreds of models with one key)
# LLM_API=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=vendor/model-name

# Ollama on the same host (free, local, private). Pick a model with tool support.
# LLM_API=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3:8b

# Max tokens per answer (spoken answers are short; reasoning models need headroom)
LLM_MAX_TOKENS=1024
# Extra JSON fields merged into every model request (provider-specific options)
# LLM_EXTRA_JSON={}

# ---- Timing ----------------------------------------------------------------
# Answers slower than this (seconds) become "Ci sto pensando, dimmi allora" (Alexa allows ~8 s in total)
ATTESA_MAX=7
# Max time a background answer may take (seconds)
LLM_TIMEOUT_LUNGO=120

# ---- Web search --------------------------------------------------------------
# auto (default): Claude uses Anthropic's native search; other models use the first backend configured below.
# Or force one: native | searxng | brave | tavily | off
WEB_SEARCH=auto
# SearXNG: free and self-hosted (enable the json format in its settings.yml: search.formats: [html, json])
SEARXNG_URL=
# Brave Search API / Tavily: hosted, with a free tier
BRAVE_API_KEY=
TAVILY_API_KEY=
# Results passed to the model, search language, native search budget per question
WEB_RESULTS=5
WEB_LANGUAGE=it
WEB_MAX=3
# Home location: used for "today", for local searches and by the native search (all optional)
HOME_CITY=
HOME_REGION=
HOME_COUNTRY=IT
HOME_TIMEZONE=Europe/Rome

# ---- Home Assistant (optional: leave HA_TOKEN empty to disable) -----------
HA_URL=https://homeassistant.example.com
# Long-lived token of a DEDICATED non-admin user
HA_TOKEN=
HA_TOOLS=1
# Entities that act on several rooms (always need a spoken "yes"), comma separated
HA_GRUPPI=cover.all_covers
# More than this many entities in one action -> spoken confirmation
HA_MAX_SENZA_CONFERMA=3
# Extra lines for the home summary: entity_id=Label,entity_id=Label
HA_SUMMARY_EXTRA=sensor.power_meter=Consumo ora,lock.front_door=Porta di casa
# Temperature sensors for the summary (regex on entity_id; empty = every temperature sensor, max 12)
HA_TEMP_PATTERN=
# Never controllable (regex on entity_id + name). The default already excludes locks, alarms, scripts,
# automations, doors/gates and technical services; override only to extend it.
# HA_VIETATO=

# ---- Network -------------------------------------------------------------
# User agent for outgoing requests (Cloudflare and similar WAFs block Python's default one)
HTTP_USER_AGENT=alexa-ai-bridge/1.0
