# Alexa AI Bridge - copy to .env, fill in, then: chmod 600 .env
# Every variable is documented in docs/setup.md#configuration-reference

# ---- Alexa ---------------------------------------------------------------
# Skill ID from the Alexa developer console (Build -> Endpoint). Requests for other skills are rejected.
SKILL_ID=amzn1.ask.skill.00000000-0000-0000-0000-000000000000
# Language of the assistant: auto answers in the language the Echo speaks, so one skill with the Italian and the
# English interaction model speaks both; it or en force one (skill/interaction-model.it-IT.json / .en-US.json)
LANGUAGE=auto
# Public DNS name of this host, used by the optional Caddy container (docker compose --profile caddy up -d).
# The skill endpoint is then https://<PUBLIC_HOST>/alexa
PUBLIC_HOST=alexa.example.com
# Version of the prebuilt image to run: latest, a major version (1 = every 1.x update) or an exact one (1.0.0)
BRIDGE_VERSION=1

# ---- Model: pick ONE block (more in docs/providers.md) ------------------
# LLM_API: "anthropic" (Messages API) or "openai" (any OpenAI-compatible Chat Completions endpoint).
# Model names are examples: use any current chat model from your provider's list. Fast models sound best.

# Anthropic Claude - native web search, nothing else to host
LLM_API=anthropic
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-5-5

# OpenAI
# LLM_API=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-5.4-mini
# LLM_EXTRA_JSON={"reasoning_effort": "low"}

# Google Gemini (OpenAI-compatible endpoint)
# LLM_API=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-flash-latest
# LLM_EXTRA_JSON={"reasoning_effort": "low"}

# Mistral
# LLM_API=openai
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_API_KEY=...
# LLM_MODEL=mistral-small-latest

# OpenRouter (hundreds of models with one key)
# LLM_API=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=vendor/model-name

# Ollama on the same host (free, local, private). Pick a model with tool support.
# LLM_API=openai
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=
# LLM_MODEL=qwen3:8b

# Max tokens per answer (spoken answers are short; reasoning models need headroom)
LLM_MAX_TOKENS=1024
# Extra JSON fields merged into every model request (provider-specific options)
# LLM_EXTRA_JSON={}

# ---- Fallback models (optional, docs/providers.md#fallback-models; easier from the admin page, Modelli tab) ----
# Up to four more models, LLM_2_* ... LLM_5_*, tried in order when the one before is unreachable, logged out,
# out of credit or over its limit: e.g. a second CLIProxyAPI with another account, or another provider.
# LLM_2_API=openai
# LLM_2_BASE_URL=http://cliproxyapi-2:8317/v1
# LLM_2_API_KEY=
# LLM_2_MODEL=gpt-5-mini
# LLM_2_EXTRA_JSON={}
# 0 skips it without removing it
# LLM_2_ATTIVO=1
# LLM_3_BASE_URL=   (and LLM_3_API, LLM_3_API_KEY, LLM_3_MODEL, LLM_3_EXTRA_JSON, LLM_3_ATTIVO; the same for 4 and 5)
# Seconds a model that does not answer is skipped (0: tried again at every question)
LLM_PAUSA=300
# Minutes between background checks that every model answers (its model list, no tokens); 0 never
LLM_CONTROLLO=10

# ---- Timing ----------------------------------------------------------------
# Answers slower than this (seconds) become "Ci sto pensando, dimmi allora" (Alexa allows ~8 s in total)
ATTESA_MAX=6
# Max time a background answer may take (seconds)
LLM_TIMEOUT_LUNGO=120

# ---- Web search --------------------------------------------------------------
# auto (default): Claude uses Anthropic's native search; other models use the first backend configured below.
# Or force one: native | searxng | brave | tavily | off
WEB_SEARCH=auto
# SearXNG: free and self-hosted. With the bundled container (docker compose --profile searxng up -d)
# use http://searxng:8080; the provided deploy/searxng/settings.yml already enables the json format.
SEARXNG_URL=
# Secret of the bundled SearXNG container: generate one with  openssl rand -hex 32
SEARXNG_SECRET=
# Brave Search API / Tavily: hosted, with a free tier
BRAVE_API_KEY=
TAVILY_API_KEY=
# Results passed to the model, search language (empty: the language of the conversation), native searches per question
WEB_RESULTS=5
WEB_LANGUAGE=
WEB_MAX=3
# Home location: used for "today", for local searches and by the native search (all optional)
HOME_CITY=
HOME_REGION=
HOME_COUNTRY=IT
HOME_TIMEZONE=Europe/Rome

# ---- Home Assistant (optional: leave HA_TOKEN empty to disable) -----------
HA_URL=https://homeassistant.example.com
# Long-lived token of a DEDICATED non-admin user
HA_TOKEN=
HA_TOOLS=1
# Entities that act on several rooms (always need a spoken "yes"), comma separated
HA_GRUPPI=cover.all_covers
# More than this many entities in one action -> spoken confirmation
HA_MAX_SENZA_CONFERMA=3
# Extra lines for the home summary: entity_id=Label,entity_id=Label
HA_SUMMARY_EXTRA=sensor.power_meter=Consumo ora,lock.front_door=Porta di casa
# Temperature sensors for the summary (regex on entity_id; empty = every temperature sensor, max 12)
HA_TEMP_PATTERN=
# Never controllable (regex on entity_id + name). The built-in list already excludes locks, alarms, scripts,
# automations, doors/gates and technical services: what you put here is ADDED to it, e.g. garage|irrigazione
# HA_VIETATO=
# Automations by voice ("ogni sera al tramonto accendi la luce del salone"): 1 = on. Always read back and created only
# after a spoken yes; the assistant only sees and changes the automations it created (docs/home-assistant.md)
HA_AUTOMAZIONI=0
# Home Assistant lets only ADMINISTRATORS create and delete automations: an admin's token, used only for that
# (empty = HA_TOKEN, which then has to be an admin's)
HA_AUTOMAZIONI_TOKEN=
# Maximum number of automations created by voice
HA_AUTOMAZIONI_MAX=20

# ---- Notifications (docs/notifications.md; easier from the admin page, Notifiche tab) ----
# 0 pauses them all. Events, comma separated: confermate, bloccate, automazioni, modelli, azioni, errori, memoria,
# pannello (none = none)
NOTIFY_ATTIVE=1
NOTIFY_EVENTI=confermate,bloccate,automazioni,modelli
NOTIFY_MAX_ORA=30
# Home Assistant app: notify services, e.g. mobile_app_my_phone (uses HA_URL / HA_TOKEN)
NOTIFY_HA=
# Telegram bot (token from @BotFather) and chat ID
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
# ntfy topic address (keep the topic hard to guess) and, for a protected server, its token
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
# Gotify server and application token
NOTIFY_GOTIFY_URL=
NOTIFY_GOTIFY_TOKEN=
# Any webhook (Discord, Slack, n8n, Node-RED...): JSON POST; optional Bearer token
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=

# ---- Memory (docs/memory.md; easier from the admin page, Memoria tab) ---------
# 1: the assistant remembers the people at home from one conversation to the next
MEMORIA=1
# 1: after every answer a short background request looks for new facts (a few more tokens); 0: only when asked
MEMORIA_AUTO=1
MEMORIA_MAX=100
# Exchanges of earlier conversations read again (0 none), and for how many days
MEMORIA_RECENTI=4
MEMORIA_GIORNI=7
# What to remember (empty: lasting facts about the people at home)
MEMORIA_ISTRUZIONI=

# ---- Network -------------------------------------------------------------
# User agent for outgoing requests (Cloudflare and similar WAFs block Python's default one)
HTTP_USER_AGENT=alexa-ai-bridge/1.0

# ---- Admin page (docs/admin.md) -------------------------------------------
# Turns the page on: 12 characters or more. Empty = no admin page.
ADMIN_PASSWORD=
# Where the page can be opened (combine as you like):
#   default                 http://127.0.0.1:8090/admin on the server (or through an SSH tunnel)
#   BRIDGE_BIND=<LAN IP>    also http://<server-ip>:8090/admin from your home network (never 0.0.0.0 on a VPS)
#   ADMIN_PUBLIC=on         also https://<PUBLIC_HOST>/admin through the bundled Caddy or your own reverse proxy
BRIDGE_BIND=127.0.0.1
# Port on the host (inside the container it is always 8090): change it if 8090 is already in use
BRIDGE_PORT=8090
ADMIN_PUBLIC=off
# Questions kept in the in-memory history (0 = no history)
ADMIN_HISTORY=100

# ---- Advanced (rarely needed) --------------------------------------------
# User agent for Home Assistant only (overrides HTTP_USER_AGENT)
# HA_UA=
# Telegram API endpoint (only for a local Bot API server)
# NOTIFY_TELEGRAM_URL=
# Replace the Italian system prompt / the voice rules added to every question (e.g. to translate the skill)
# SYSTEM_PROMPT=
# ISTRUZIONI_TURNO=
# Alternative API endpoints for Brave / Tavily (a proxy, for example)
# BRAVE_URL=https://api.search.brave.com/res/v1/web/search
# TAVILY_URL=https://api.tavily.com/search
