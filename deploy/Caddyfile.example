# Alexa needs a public HTTPS endpoint with a certificate from a trusted CA.
# Caddy obtains it automatically from Let's Encrypt (ports 80 and 443 must be reachable from the internet).
#
# - with  docker compose --profile caddy  this file is used as is: set PUBLIC_HOST (and ADMIN_PUBLIC) in .env;
# - with Caddy installed on the host: copy it to /etc/caddy/Caddyfile and set the same variables for the Caddy
#   service, or replace the placeholders below.

{$PUBLIC_HOST:alexa.example.com} {
	# The admin page is answered with 404 unless ADMIN_PUBLIC is exactly "on" (any other value, or none, hides it)
	@admin_nascosta {
		path /admin /admin/*
		not expression `{env.ADMIN_PUBLIC} == "on"`
	}
	respond @admin_nascosta 404

	reverse_proxy {$UPSTREAM:127.0.0.1:8090}
	log {
		output stdout
		format json
	}
}
